# Configuración del Sistema Agéntico de Tickets
# Copiar este archivo como .env y completar con las claves reales

# Token de Acceso de App Privada de HubSpot (requiere permisos de lectura de tickets y contactos)
HUBSPOT_ACCESS_TOKEN=tu_token_privado_hubspot_aqui

# API Key de Google Gemini (obtenida de Google AI Studio)
GEMINI_API_KEY=tu_api_key_gemini_aqui

# (Opcional) Webhook de n8n si se prefiere orquestar la extracción mediante n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/tickets

# Modelo de Gemini a utilizar (Recomendado por eficiencia económica: gemini-2.5-flash o gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Puerto del servidor local
PORT=8000
